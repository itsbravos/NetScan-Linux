# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Autenticação do painel (opcional) ---
# Se nenhuma das duas variáveis abaixo for definida, uma senha de admin é
# gerada automaticamente no primeiro boot e impressa uma única vez no
# console do servidor (o hash é persistido em data/admin_auth.json).

# Hash bcrypt pronto da senha de admin (uso avançado/produção).
# ADMIN_PASSWORD_HASH="$2a$10$..."

# Senha de admin em texto puro — hasheada automaticamente no boot.
# Conveniente para desenvolvimento; prefira ADMIN_PASSWORD_HASH em produção.
# ADMIN_PASSWORD="troque-esta-senha"
